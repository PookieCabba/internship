# ============================================================
# PhishGuard AI — Environment Configuration Template
# Copy this file to .env and configure your local or production values:
#   cp .env.example .env
# ============================================================

# --- External Threat Intelligence Feeds ---
# (URLhaus by abuse.ch is included automatically with no API key needed)
GOOGLE_SAFE_BROWSING_API_KEY=your_key_here


# --- CORS & Security Settings ---
# Comma-separated list of allowed origins (e.g., https://your-streamlit-app.streamlit.app,http://localhost:8501)
ALLOWED_ORIGINS=https://your-streamlit-app.streamlit.app

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# --- Model Artifact Paths ---
MODEL_PATH=models/phishing_model.joblib
SCALER_PATH=models/feature_scaler.joblib
METADATA_PATH=models/model_metadata.json
